# 复制成 .env 后按需修改；.env 已在 .gitignore 中，不提交到 Git。
# Vite 启动时会自动读取本文件里 VITE_ 开头的变量。

# 浏览器访问后端用的地址。必须是宿主机可访问的地址，
# 不能写容器服务名（例如 http://backend:8000，浏览器解析不了）。
VITE_API_BASE_URL=http://localhost:8000

# 浏览器访问 CopilotKit Runtime 用的地址，同样必须是宿主机地址。
VITE_COPILOT_RUNTIME_URL=http://localhost:8787

# 前端对外端口。改这里时，后端的 CORS_ORIGINS 也要同步改。
FRONTEND_PORT=5173

# ---------- CopilotKit Runtime（容器内运行时才用得上）----------
# Runtime 对外端口
RUNTIME_PORT=8787
# Runtime 转发到 Python AG-UI 入口的地址。
# 容器内走共享网络的服务名；本机直跑时用 http://127.0.0.1:8000/agent。
AGENT_URL=http://backend:8000/agent
# 前端 Provider 里登记的 agentId，必须和后端 Agent 的 name 一致
AGENT_ID=todo_assistant
# 允许访问 Runtime 的浏览器来源
RUNTIME_CORS_ORIGINS=http://localhost:5173
