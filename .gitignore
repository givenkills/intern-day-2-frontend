# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
.vite/
# PWA 插件在开发模式生成的中间产物
dev-dist/
*.local

# ---------- 安卓 APK ----------
# 只在本地构建和安装，产物不进仓库
android-app/*.apk
android-app/build/
android-app/local.properties

# ---------- Python 相关（两个仓库使用同一套忽略规则，便于对照） ----------
.venv/
__pycache__/
*.py[cod]

# ---------- 环境变量：只保留占位示例 ----------
.env
.env.*
!.env.example

# ---------- 编辑器与系统临时文件 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.log
