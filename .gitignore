# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
.vite/
# PWA 插件在开发模式生成的中间产物
dev-dist/
*.local

# ---------- 安卓 APK ----------
# 只在本地构建和安装，产物不进仓库
android-app/*.apk
android-app/build/
android-app/local.properties

# ---------- Capacitor / Android 平台 ----------
# 平台工程要提交（原生配置是源码），但构建产物、本机路径、密钥一律不提交
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
# Web 资源是 pnpm build:android 的产物，由 cap copy/sync 生成
android/app/src/main/assets/public/
*.jks
*.keystore

# ---------- Python 相关（两个仓库使用同一套忽略规则，便于对照） ----------
.venv/
__pycache__/
*.py[cod]

# ---------- 环境变量：只保留占位示例 ----------
.env
.env.*
!.env.example
# Android 构建模板只含 10.0.2.2 与端口，可以入库；个人 IP 仍走 .env.android.local
!.env.android

# ---------- 编辑器与系统临时文件 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.log
